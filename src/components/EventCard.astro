---
import StatusBadge from "@/components/StatusBadge.astro";
import type { Event } from "@/content/schemas";
import { formatDate } from "@/lib/dates";
import { formatFee } from "@/lib/event";
import type { EventPhase } from "@/lib/status";

interface Props {
  id: string;
  event: Event;
  phase: EventPhase;
  headingLevel?: "h3" | "h2";
}

const { id, event, phase, headingLevel: Heading = "h3" } = Astro.props;
const fee = formatFee(event.fee);
---

<article class="relative flex flex-col rounded-2xl border border-line bg-white p-5">
  <StatusBadge
    label={phase === "demnaechst" ? "Demnächst" : "Rückblick"}
    tone={phase === "demnaechst" ? "active" : "neutral"}
  />
  <Heading class="mt-3 text-lg">
    <a href={`/aktuelles/${id}`} class="after:absolute after:inset-0 hover:underline">
      {event.title}
    </a>
  </Heading>
  <p class="mt-1 font-semibold">{formatDate(event.start, "long")}</p>
  <p class="text-ink-muted">
    {event.venue.name}
    {event.ageRange && ` · ${event.ageRange.min}–${event.ageRange.max} Jahre`}
    {fee && ` · ${fee}`}
  </p>
</article>
