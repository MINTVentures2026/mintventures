---
interface Props {
  title: string;
  id?: string;
  eyebrow?: string;
  intro?: string;
}

const { title, id, eyebrow, intro } = Astro.props;
---

<header class="mb-8 max-w-3xl space-y-3">
  {eyebrow && <p class="text-sm font-semibold tracking-wide text-ink-muted uppercase">{eyebrow}</p>}
  <h2 id={id} class="text-2xl sm:text-3xl">
    {title}
  </h2>
  {intro && <p class="text-lg text-ink-muted">{intro}</p>}
  <slot />
</header>
