---
import { lessonFlow } from "@/config/learning";
---

<ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {lessonFlow.map((step, i) => (
    <li class="rounded-2xl border border-line bg-white p-5">
      <span class="flex size-9 items-center justify-center rounded-full bg-brand font-bold text-white">{i + 1}</span>
      <h3 class="mt-3 text-lg">{step.title}</h3>
      <p class="text-ink-muted">{step.text}</p>
    </li>
  ))}
</ol>
