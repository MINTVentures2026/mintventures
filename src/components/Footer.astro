---
import { Image } from "astro:assets";
import logo from "@/assets/logo.png";
import Icon from "@/components/Icon.astro";
import { footerNav, legalNav, site } from "@/config/site";

const year = new Date().getFullYear();
const linkClass = "underline decoration-white/50 underline-offset-4 hover:decoration-white";
---

<footer class="on-brand bg-brand text-white">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="space-y-4">
      <a href="/" class="inline-block rounded-lg bg-white px-4 py-3" aria-label="MINT Ventures – zur Startseite">
        <Image src={logo} alt="" widths={[180, 360]} sizes="180px" class="h-auto w-40" />
      </a>
      <p class="text-xl font-bold text-balance">{site.claim}</p>
      <p>{site.tagline}</p>
    </div>

    <div>
      <h2 class="mb-3 text-base font-bold text-white">Kontakt</h2>
      <ul class="space-y-2">
        <li class="flex items-center gap-2">
          <Icon name="mail" />
          <a href={`mailto:${site.email}`} class={linkClass}>
            {site.email}
          </a>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="chat" />
          <a href={site.whatsapp.link} class={linkClass}>
            WhatsApp {site.whatsapp.display}
          </a>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="map-pin" />
          <span>Kursort: {site.venue}</span>
        </li>
      </ul>
    </div>

    <nav aria-label="Footer">
      <h2 class="mb-3 text-base font-bold text-white">Seiten</h2>
      <ul class="space-y-2">
        {footerNav.map((link) => (
          <li>
            <a href={link.href} class={linkClass}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/20">
    <div class="container-page flex flex-col gap-3 py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p>{[`© ${year} ${site.name}`, site.legalOperator].filter(Boolean).join(" · ")}</p>
      <nav aria-label="Rechtliches">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {legalNav.map((link) => (
            <li>
              <a href={link.href} class={linkClass}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>
