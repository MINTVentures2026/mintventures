---
// Teaser for a course product (homepage, /kurse). Status always comes from the data:
// the current run for the weekend course, "In Planung" for planned products.
import StatusBadge from "@/components/StatusBadge.astro";
import { enquiryHref } from "@/config/enquiry";
import type { Event, Product, Run } from "@/content/schemas";
import { formatDate } from "@/lib/dates";
import { plannedDisplay, runStatus, runStatusDisplay } from "@/lib/status";

interface Props {
  id: string;
  product: Product;
  today: string;
  run?: Run;
  /** Next upcoming workshop, for the workshops product. */
  workshop?: Event;
}

const { id, product, today, run, workshop } = Astro.props;
const href = `/kurse/${id}`;
const planned = product.status === "in-planung";

const badge = planned
  ? { label: plannedDisplay(product.expectedPeriod).label, tone: "planned" as const }
  : run
    ? { label: runStatusDisplay[runStatus(run, today)].label, tone: "active" as const }
    : product.nextRun
      ? { label: plannedDisplay(product.nextRun.period).label, tone: "planned" as const }
      : null;
const cta = planned ? plannedDisplay().cta! : null;
---

<article class="relative flex flex-col rounded-2xl border border-line bg-white p-6">
  <h3 class="text-xl">
    <a href={href} class="hover:underline">
      {product.name}
    </a>
  </h3>
  {badge?.label && (
    <div class="mt-2">
      <StatusBadge label={badge.label} tone={badge.tone} />
    </div>
  )}
  <p class="mt-3 flex-1 text-ink-muted">{product.summary}</p>
  {workshop && (
    <p class="mt-3">
      <strong>Nächster Workshop:</strong> {workshop.title}, {formatDate(workshop.start, "long")}
    </p>
  )}
  <div class="mt-5 flex flex-wrap gap-3">
    {cta ? (
      <a href={enquiryHref(cta.intent)} class="btn-secondary">
        {cta.label}
      </a>
    ) : (
      <a href={href} class="btn-secondary">
        {run ? "Zum Kurs" : "Mehr erfahren"}
      </a>
    )}
  </div>
</article>
