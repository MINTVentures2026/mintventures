---
import Icon from "@/components/Icon.astro";
import { site, trialHref } from "@/config/site";

// Fixed bottom bar below 768 px (plan §3.3). body reserves its height in global.css.
---

<nav
  aria-label="Schnellkontakt"
  class="fixed inset-x-0 bottom-0 z-40 grid h-[calc(var(--spacing-action-bar)+env(safe-area-inset-bottom))] grid-cols-2 gap-3 border-t border-line bg-white px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] shadow-[0_-4px_16px_rgb(0_0_0/0.08)] md:hidden"
>
  <a href={trialHref} class="btn-primary px-3">
    Probestunde anfragen
  </a>
  <a href={site.whatsapp.link} class="btn-secondary px-3" aria-label={`WhatsApp-Nachricht an ${site.name}`}>
    <Icon name="chat" />
    WhatsApp
  </a>
</nav>
