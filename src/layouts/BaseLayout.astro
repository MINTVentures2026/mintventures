---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import MobileActionBar from "@/components/MobileActionBar.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Search Console ownership (keep: the property must survive the relaunch) -->
    <meta name="google-site-verification" content="8-cWE6lWGDNKGGxRosFLjrz1XPAqbOyTa9fbobj0hXU" />
    <meta name="theme-color" content="#346d57" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="flex flex-col">
    <a
      href="#inhalt"
      class="sr-only z-50 rounded-md bg-accent px-4 py-2 font-semibold text-ink focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Zum Inhalt springen
    </a>
    <Header />
    <main id="inhalt" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
  </body>
</html>
