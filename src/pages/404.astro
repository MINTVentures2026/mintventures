    <div class="flex flex-wrap gap-3">
      <a href="/" class="btn-secondary">
        Zur Startseite
      </a>
      <a href="/kurse" class="btn-secondary">
        Unsere Kurse
      </a>
    </div>
  </section>
</BaseLayout>
