---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EventCard from "@/components/EventCard.astro";
import Icon from "@/components/Icon.astro";
import LearningSteps from "@/components/LearningSteps.astro";
import ProductCard from "@/components/ProductCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import { enquiryHref } from "@/config/enquiry";
import { learningSteps, stepColor } from "@/config/learning";
import { site, trialHref } from "@/config/site";
import { formatEuro } from "@/lib/course";
import { getAchievements, getCurrentRun, getProduct, getProducts, getRecaps, getUpcomingEvents } from "@/lib/content";
import { berlinToday, formatDate } from "@/lib/dates";
import { eventPhase, plannedDisplay, runStatus, runStatusDisplay } from "@/lib/status";

const today = berlinToday();
const products = await getProducts();
const weekend = await getProduct("robotik-wochenendkurs");
const others = products.filter((p) => p.id !== weekend.id);
const runEntry = await getCurrentRun(weekend.id, today);
const run = runEntry?.data;
const status = run ? runStatus(run, today) : null;
const display = status ? runStatusDisplay[status] : null;
const nextWorkshop = (await getUpcomingEvents(today, "workshop"))[0];

// 04 Aktuelles: next 1–2 events + the latest recap, max. 3 cards (plan Phase 3).
const news = [...(await getUpcomingEvents(today)).slice(0, 2), ...(await getRecaps(today)).slice(0, 1)];
const achievements = await getAchievements();

const cardFacts = run && [
  `${run.ageRange.min}–${run.ageRange.max} Jahre`,
  `${run.dates.length} Termine à ${run.sessionMinutes} Minuten`,
  run.venue.name.replace(" (H-BRS)", ""),
  `${formatEuro(run.fee.amount)}${run.fee.note ? ` (${run.fee.note})` : ""}`,
  ...(run.trial
    ? [`Probestunde ${formatEuro(run.trial.price)}${run.trial.credited ? " (wird angerechnet)" : ""}`]
    : []),
];
---

<BaseLayout
  title="Robotik- & Programmierkurse für Kinder in Bonn | MINT Ventures"
  description="Robotik und Programmieren für Kinder von 8–14 Jahren in Bonn und Sankt Augustin. Kleine Gruppen, LEGO SPIKE Prime, Wettbewerbe. Jetzt Probestunde anfragen."
>
  <!-- 01 Hero. The big claim is the visual headline; the semantic H1 is the location line (plan Phase 5). -->
  <section class="bg-surface">
    <div class="container-page grid items-center gap-10 py-12 lg:grid-cols-[1.3fr_1fr] lg:py-20">
      <div class="space-y-5">
        <p class="text-sm font-semibold text-ink-muted">
          Kleine Gruppen · Projektbasiert · LEGO® Education SPIKE™ Prime
        </p>
        <p class="text-4xl leading-tight font-bold text-balance text-brand sm:text-5xl">
          Kinder gestalten Technologie. Nicht nur konsumieren.
        </p>
        <h1 class="text-lg font-semibold text-ink sm:text-xl">
          Robotik- und Programmierkurse für Kinder von 8 bis 14 Jahren in Bonn und Sankt Augustin
        </h1>
        <p class="max-w-2xl text-lg">
          Bei MINT Ventures bauen und programmieren Kinder eigene Roboter, testen Ideen und lösen technische
          Herausforderungen – in kleinen Gruppen und mit viel Freude am Ausprobieren.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href={trialHref} class="btn-primary">
            Probestunde anfragen
          </a>
          <a href="#kurse" class="btn-secondary">
            Aktuelle Kurse ansehen
          </a>
        </div>
      </div>
      <!-- Hero photo stays off until photo consent is documented (plan §7 / appendix 01). -->
      <ul class="hidden grid-cols-5 gap-2 sm:grid lg:grid-cols-1 lg:gap-3" aria-hidden="true">
        {learningSteps.map((step, i) => (
          <li class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-sm" style={`margin-left: ${i * 1.25}rem`}>
            <span class:list={["size-3 shrink-0 rounded-full", stepColor[step.key]]} />
            <span class="font-bold text-ink">{step.name}</span>
            <span class="hidden text-ink-muted xl:inline">{step.area}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 02 Unsere Kurse (automatic from data) -->
  <section aria-labelledby="kurse" class="scroll-mt-20 py-14">
    <div class="container-page">
      <SectionHeader id="kurse" title="Unsere Kurse" />
      <div class="grid gap-5 lg:grid-cols-3">
        <article class="relative rounded-2xl border-2 border-brand bg-white p-6 lg:col-span-3 lg:grid lg:grid-cols-[1fr_auto] lg:gap-8">
          <div class="space-y-3">
            {run && status !== "laeuft" && (
              <p class="font-semibold text-ink-muted">Nächster Kursstart: {formatDate(run.dates[0], "long")}</p>
            )}
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="text-2xl">{run?.title ?? weekend.data.name}</h3>
              {display?.label && <StatusBadge label={display.label} tone="active" />}
              {!run && <StatusBadge label={plannedDisplay(weekend.data.nextRun?.period).label!} tone="planned" />}
            </div>
            <p class="text-ink-muted">
              {weekend.data.name} · {weekend.data.stages[0].label}
            </p>
            {cardFacts && (
              <ul class="flex flex-wrap gap-x-4 gap-y-1">
                {cardFacts.map((fact) => (
                  <li class="flex items-center gap-2">
                    <span class="size-1.5 rounded-full bg-brand" aria-hidden="true" />
                    {fact}
                  </li>
                ))}
              </ul>
            )}
            {status === "laeuft" && weekend.data.nextRun && (
              <p>
                <strong>Nächster Grundlagenkurs:</strong> {weekend.data.nextRun.period} (in Planung)
              </p>
            )}
          </div>
          <div class="mt-5 flex flex-col gap-3 lg:mt-0 lg:justify-center">
            <a href={`/kurse/${weekend.id}`} class="btn-primary">
              Zum Kurs
            </a>
            {status === "laeuft" && (
              <a href={enquiryHref("kursplatz")} class="btn-secondary">
                Interesse vormerken
              </a>
            )}
          </div>
        </article>

        {others.map((p) => (
          <ProductCard
            id={p.id}
            product={p.data}
            today={today}
            workshop={p.id === "workshops-feriencamps" ? nextWorkshop?.data : undefined}
          />
        ))}
        <aside class="flex flex-col justify-center rounded-2xl bg-surface p-6">
          <p class="font-semibold">Alle Angebote im Überblick</p>
          <a href="/kurse" class="mt-2 font-semibold text-brand underline underline-offset-4">
            Zu allen Kursen
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- 03 Lernen durch Ausprobieren -->
  <section aria-labelledby="lernweg" class="bg-surface py-14">
    <div class="container-page">
      <SectionHeader
        id="lernweg"
        title="Lernen durch Ausprobieren"
        intro="Kinder bauen, programmieren, nutzen Sensoren, automatisieren Abläufe und entwickeln eigene Lösungen. Aufgaben mit unterschiedlichem Schwierigkeitsgrad lassen Raum für eigene Lösungswege."
      />
      <LearningSteps />
      <a href="/so-lernen-kinder" class="mt-6 inline-block font-semibold text-brand underline underline-offset-4">
        So lernen Kinder bei uns
      </a>
    </div>
  </section>

  {news.length > 0 && (
    <section aria-labelledby="aktuelles" class="py-14">
      <div class="container-page">
        <SectionHeader
          id="aktuelles"
          title="Aktuelles & Projekte"
          intro="Einblicke in Workshops, Robotik-Wettbewerbe und Bildungsprojekte in der Region Bonn/Rhein-Sieg."
        />
        <div class="grid gap-5 md:grid-cols-3">
          {news.map((e) => (
            <EventCard id={e.id} event={e.data} phase={eventPhase(e.data, today)} />
          ))}
        </div>
        <a href="/aktuelles" class="mt-6 inline-block font-semibold text-brand underline underline-offset-4">
          Alle Neuigkeiten
        </a>
      </div>
    </section>
  )}

  {achievements.length > 0 && (
    <section aria-labelledby="erfolge" class="bg-surface py-14">
      <div class="container-page">
        <SectionHeader id="erfolge" title="MINT Ventures in Aktion" />
        <ul class="grid gap-4 md:grid-cols-2">
          {achievements.map(({ data }) => (
            <li class="rounded-2xl bg-white p-5">
              <p class="text-sm font-semibold text-ink-muted">{formatDate(data.date, "long")}</p>
              <h3 class="mt-1 text-lg">{data.title}</h3>
              <p>{data.resultLine}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 06 Kooperationen -->
  <section aria-labelledby="kooperation" class="py-14">
    <div class="container-page grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <div class="space-y-4">
        <h2 id="kooperation" class="text-2xl sm:text-3xl">
          Für Schulen, Unternehmen & Veranstalter
        </h2>
        <p class="text-lg font-semibold">
          Robotik und Coding für Bildungsprojekte und Events: Ob Schul-AG, Projekttag, Family Day oder
          MINT-Veranstaltung – wir gestalten praxisnahe Robotik- und Programmierangebote für Kinder und Jugendliche.
        </p>
        <p>
          Gemeinsam entwickeln wir ein passendes Format für Ihre Zielgruppe und Veranstaltung. Die technische
          Ausstattung können wir nach Absprache bereitstellen.
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <a href={enquiryHref("kooperation")} class="btn-primary">
          Kooperation anfragen
        </a>
        <a href={site.whatsapp.link} class="btn-secondary">
          <Icon name="chat" /> WhatsApp
        </a>
        <a href={`mailto:${site.email}`} class="text-center font-semibold text-brand underline underline-offset-4">
          {site.email}
        </a>
      </div>
    </div>
  </section>

  <!-- 07 Probestunde & Kontakt -->
  <section aria-labelledby="ausprobieren" class="on-brand bg-brand-strong py-14 text-white">
    <div class="container-page grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <div class="space-y-4">
        <h2 id="ausprobieren" class="text-2xl text-white sm:text-3xl">
          Robotik selbst ausprobieren?
        </h2>
        <p class="text-lg">
          Lernen Sie uns in einer Probestunde kennen
          {run?.trial &&
            ` (${formatEuro(run.trial.price)}, wird bei Anmeldung vollständig auf die Kursgebühr angerechnet)`}
          . Wir beantworten Ihre Fragen persönlich und finden gemeinsam die passende Gruppe für Ihr Kind.
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <a href={trialHref} class="btn-primary">
          Probestunde anfragen
        </a>
        <a href={site.whatsapp.link} class="btn border-2 border-white text-white hover:bg-white/10">
          <Icon name="chat" /> WhatsApp
        </a>
        <a href={`mailto:${site.email}`} class="text-center font-semibold underline underline-offset-4">
          {site.email}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
