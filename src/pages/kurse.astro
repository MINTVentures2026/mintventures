---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductCard from "@/components/ProductCard.astro";
import { getCurrentRun, getProducts, getUpcomingEvents } from "@/lib/content";
import { berlinToday } from "@/lib/dates";

const today = berlinToday();
const products = await getProducts();
const runs = Object.fromEntries(
  await Promise.all(products.map(async (p) => [p.id, (await getCurrentRun(p.id, today))?.data])),
);
const nextWorkshop = (await getUpcomingEvents(today, "workshop"))[0]?.data;
---

<BaseLayout
  title="Kurse: Robotik, Programmieren & Workshops für Kinder | MINT Ventures"
  description="Wochenendkurse, Wettbewerbsteams, Workshops und Feriencamps: Robotik und Programmieren für Kinder von 8–14 Jahren in Bonn und Sankt Augustin."
>
  <section class="container-page py-10 lg:py-14">
    <div class="max-w-3xl space-y-4">
      <h1 class="text-3xl sm:text-4xl">Unsere Kurse und Programme</h1>
      <p class="text-lg">
        Ob regelmäßiger Wochenendkurs, Wettbewerbsvorbereitung oder ein Workshop zum Ausprobieren – bei uns finden
        Kinder von 8 bis 14 Jahren den passenden Einstieg in Robotik und Programmierung.
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {products.map((p) => (
        <ProductCard
          id={p.id}
          product={p.data}
          today={today}
          run={runs[p.id]}
          workshop={p.id === "workshops-feriencamps" ? nextWorkshop : undefined}
        />
      ))}
    </div>

    <details class="mt-10 max-w-3xl rounded-2xl bg-surface p-5">
      <summary class="cursor-pointer font-semibold text-brand">Wie werden die Gruppen eingeteilt?</summary>
      <p class="mt-3">
        Wir berücksichtigen Alter, Vorkenntnisse und Lerntempo. Bei ausreichender Nachfrage bieten wir altersnahe
        Lerngruppen an. Die konkrete Einteilung erfolgt in Abstimmung mit den Familien.
      </p>
    </details>
  </section>
</BaseLayout>
