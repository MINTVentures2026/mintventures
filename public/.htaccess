# Apache config for the All-Inkl webspace. Vite copies this file into dist/.
# Production: www.mintventures.de. Staging: staging.mintventures.de.

DirectoryIndex index.html
Options -Indexes

# Visitors only ever need what the build produced, never dotfiles
# (e.g. the deploy marker).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always HTTPS. HSTS is already cached in browsers, so plain HTTP would fail anyway.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # The canonical host is www (see <link rel="canonical"> in index.html).
  RewriteCond %{HTTP_HOST} ^mintventures\.de(:[0-9]+)?$ [NC]
  RewriteRule ^ https://www.mintventures.de%{REQUEST_URI} [R=301,L]

  # Client-side routes (src/App.tsx). Keep these in sync with the router and public/sitemap.xml.
  RewriteRule ^(impressum|datenschutz)$ index.html [L]
</IfModule>

# Unknown paths: real 404 status, and the app renders its NotFound page.
ErrorDocument 404 /index.html

AddType font/woff2 .woff2

<IfModule mod_headers.c>
  # "always" so the headers are on 404s and redirects too.
  Header always set Strict-Transport-Security "max-age=63072000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # Vite puts content hashes in /assets/* file names, so those can be cached forever.
  # Everything else (HTML, images in /images) is revalidated.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <Else>
    Header set Cache-Control "no-cache"
  </Else>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
